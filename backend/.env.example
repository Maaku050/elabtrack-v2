APP_ENV=development
APP_PORT=8080
APP_NAME=eLabTrack V2
APP_READ_TIMEOUT=10s
APP_WRITE_TIMEOUT=15s
APP_BODY_LIMIT=1MB

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=elabtrack_v2
DB_USER=postgres
DB_PASSWORD=
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=15m

JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=elabtrack-v2

FRONTEND_URL=http://localhost:5173
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1m
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

LOG_LEVEL=info
LOG_FORMAT=console
