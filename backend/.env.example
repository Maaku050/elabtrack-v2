# Local development only. Production: see .env.production.example and PHASE1_FOUNDATION.md.
APP_ENV=development
APP_PORT=8080
APP_NAME=eLabTrack V2
APP_READ_TIMEOUT=10s
APP_WRITE_TIMEOUT=15s
APP_IDLE_TIMEOUT=60s
APP_BODY_LIMIT=1MB

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=elabtrack_v2
DB_USER=elabtrack_runtime
DB_PASSWORD=elabtrack-local-runtime
# CLI-only schema-owner connection; keep absent from production API processes.
MIGRATION_DATABASE_URL=postgresql://elabtrack_migrator:elabtrack-local-migrator@127.0.0.1:5432/elabtrack_v2?sslmode=disable
# Local Compose has no TLS. Production requires explicit verify-full.
DB_SSLMODE=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=15m

# Published development-only key; rejected in production.
JWT_SECRET=elabtrack-local-development-only-signing-key
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=elabtrack-v2

FRONTEND_URL=http://localhost:5173
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1m
LOGIN_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_MAX=60
REGISTER_RATE_LIMIT_MAX=5
# Empty: socket peer only. Configure literal proxy IPs/CIDRs deliberately;
# never trust all private/loopback addresses merely because Docker is used.
TRUSTED_PROXIES=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

LOG_LEVEL=info
LOG_FORMAT=console

# Approved institutional input; blank disables Student creation/activation.
# Faculty creation and existing-account management remain independent.
STUDENT_EMAIL_DOMAINS=
# Technical defaults; not final institutional activation/recovery policy.
ACTIVATION_TTL=24h
ACTIVATION_RESEND_COOLDOWN=1m
# Defaults to FRONTEND_URL + /activate; must match that trusted origin/path.
# ACTIVATION_URL=http://localhost:5173/activate
# Backend-only Brevo settings. Blank means UNCONFIGURED, never live delivery.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=FSMO eLabTrack
