# Export/inject these settings through your deployment environment/secret store.
# Production does not load .env automatically. Blank required fields intentionally fail.
# No provider, host, certificate or production credentials are supplied here.
APP_ENV=production
APP_PORT=8080
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=verify-full
# Optional: system (default), or the path to an existing trusted PEM CA bundle.
# DB_SSLROOTCERT=system
# Alternatively use DATABASE_URL with encoded credentials and ?sslmode=verify-full;
# remove DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD when choosing URL configuration.
JWT_SECRET=
JWT_ISSUER=elabtrack-v2
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
FRONTEND_URL=
ALLOWED_ORIGINS=
LOG_LEVEL=info
LOG_FORMAT=json
