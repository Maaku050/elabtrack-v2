# Export/inject these settings through your deployment environment/secret store.
# Production does not load .env automatically. Blank required fields intentionally fail.
# No provider, host, certificate or production credentials are supplied here.
APP_ENV=production
APP_PORT=8080
APP_READ_TIMEOUT=10s
APP_WRITE_TIMEOUT=15s
APP_IDLE_TIMEOUT=60s
APP_BODY_LIMIT=1MB
# Per-process fixed windows, by effective client IP; operational defaults.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1m
LOGIN_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_MAX=60
REGISTER_RATE_LIMIT_MAX=5
# Empty deliberately uses the socket peer. Behind an approved proxy, supply
# only its actual literal IPs/CIDRs; it must sanitize XFF/XFP and block bypass.
# No provider or production network topology is assumed.
TRUSTED_PROXIES=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=verify-full
# Optional: system (default), or the path to an existing trusted PEM CA bundle.
# DB_SSLROOTCERT=system
# Alternatively use DATABASE_URL with encoded credentials and ?sslmode=verify-full;
# remove DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD when choosing URL configuration.
JWT_SECRET=
JWT_ISSUER=elabtrack-v2
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
FRONTEND_URL=
ALLOWED_ORIGINS=
LOG_LEVEL=info
LOG_FORMAT=json

# Migration operator ONLY: inject separately when running explicit migration CLI.
# API startup needs only runtime DB_* / DATABASE_URL; no migration secret needed.
# MIGRATION_DATABASE_URL=postgresql://<encoded-migrator>:<encoded-password>@<same-db-host>:5432/<same-db-name>?sslmode=verify-full
# Include sslrootcert in this URL if a private CA is needed. Production CLI refuses
# missing migration credentials, the runtime username, or a different target DB.
