# Local Docker Compose only. These published values are NOT production credentials.
BOOTSTRAP_DB_USER=postgres
BOOTSTRAP_DB_PASSWORD=postgres
MIGRATION_DB_PASSWORD=elabtrack-local-migrator
DB_USER=elabtrack_runtime
DB_PASSWORD=elabtrack-local-runtime
DB_NAME=elabtrack_v2
# Host published port; backend container always connects to port 5432.
DB_PORT=5432
# Public browser build configuration, never a secret.
VITE_API_URL=/api/v1
